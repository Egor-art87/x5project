# Скопируй этот файл в .env и подставь свои значения.
# .env в git не коммитится — там хранятся секреты.

# --- БД ---
# Локально: SQLite (никаких установок не требуется).
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Для Postgres строка выглядит так:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/x5db

# --- JWT ---
# В проде сгенерируй чем-то вроде: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Прочее ---
DEBUG=true
